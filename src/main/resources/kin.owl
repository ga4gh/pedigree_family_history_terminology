############################
#   Object Properties
############################

# Object Property: KIN_001 (isRelativeOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_001> "isRelativeOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_001> "A relation that indicates that a person is connected to another biologically or through a socio-legal relationship."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_001> owl:topObjectProperty)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_001>)
TransitiveObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_001>)
ObjectPropertyDomain(<http://purl.org/ga4gh/kin.owl#KIN_001> <http://purl.org/ga4gh/kin.owl#KIN_998>)
ObjectPropertyRange(<http://purl.org/ga4gh/kin.owl#KIN_001> <http://purl.org/ga4gh/kin.owl#KIN_998>)

# Object Property: KIN_002 (isBiologicalRelativeOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_002> "isBiologicalRelativeOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_002> "A relation that indicates that a person is related to another person biologically."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_002> <http://purl.org/ga4gh/kin.owl#KIN_001>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_002>)

# Object Property: KIN_200 (isBiologicalParentOf)  [replaces deprecated KIN_003]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_200> "isBiologicalParentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_200> "A relation that indicates that a person is the biological parent (egg and gestational carrier, or sperm) of another person."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_200> <http://purl.org/ga4gh/kin.owl#KIN_002>)
InverseObjectProperties(<http://purl.org/ga4gh/kin.owl#KIN_200> <http://purl.org/ga4gh/kin.owl#KIN_032>)
DisjointObjectProperties(<http://purl.org/ga4gh/kin.owl#KIN_200> <http://purl.org/ga4gh/kin.owl#KIN_032>)

# Object Property: KIN_027 (isBiologicalMotherOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_027> "isBiologicalMotherOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_027> "A relation that indicates that a person is the biological mother (egg and gestational carrier) of another person."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_027> <http://purl.org/ga4gh/kin.owl#KIN_200>)
InverseFunctionalObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_027>)

# Object Property: KIN_028 (isBiologicalFatherOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_028> "isBiologicalFatherOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_028> "A relation that indicates that a person is the biological father (sperm) of another person."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_028> <http://purl.org/ga4gh/kin.owl#KIN_200>)
InverseFunctionalObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_028>)

# Object Property: KIN_032 (isBiologicalChildOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_032> "isBiologicalChildOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_032> "A relation that indicates that a person is the biological child of another person (sperm or egg)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_032> <http://purl.org/ga4gh/kin.owl#KIN_002>)

# Object Property: KIN_004 (isSpermDonorOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_004> "isSpermDonorOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_004> "A relation between a person who donated their sperm and the child."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_004> <http://purl.org/ga4gh/kin.owl#KIN_002>)

# Object Property: KIN_038 (isOvumDonorOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_038> "isOvumDonorOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_038> "A relation between a person who donated an egg to another to help them conceive and the child."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_038> <http://purl.org/ga4gh/kin.owl#KIN_002>)

# Object Property: KIN_029 (isMitochondrialDonorOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_029> "isMitochondrialDonorOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_029> "A relation between a person that has donated mitochondria and a child. Mitochondrial donation involves removing the nuclear DNA from a person's ovum containing faulty mitochondria and inserting it into a healthy donor ovum, which has had its nuclear DNA removed."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_029> <http://purl.org/ga4gh/kin.owl#KIN_002>)
InverseFunctionalObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_029>)

# Object Property: KIN_005 (isGestationalCarrierOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_005> "isGestationalCarrierOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_005> "A relation between the person who carried a fertilised egg in their womb and gave birth to a child on behalf of another, and the child."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_005> <http://purl.org/ga4gh/kin.owl#KIN_002>)
InverseFunctionalObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_005>)

# Object Property: KIN_006 (isSurrogateOvumDonorOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_006> "isSurrogateOvumDonorOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_006> "A relation between a person who carried their own fertilised egg in their womb and gave birth to a child on behalf of another, and the child."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_006> <http://purl.org/ga4gh/kin.owl#KIN_002>)
InverseFunctionalObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_006>)

# Object Property: KIN_007 (isBiologicalSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_007> "isBiologicalSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_007> "A relation between two people that have one or both biological parents (by sperm and/or egg) in common. (Prefer to use isFullSiblingOf or isHalfSiblingOf if known)"@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_007> <http://purl.org/ga4gh/kin.owl#KIN_002>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_007>)

# Object Property: KIN_008 (isFullSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_008> "isFullsiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_008> "A relation between two people that have both biological parents (sperm, egg) in common."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_008> <http://purl.org/ga4gh/kin.owl#KIN_007>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_008>)
TransitiveObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_008>)

# Object Property: KIN_009 (isMultipleBirthSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_009> "isMultipleBirthSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_009> "A relation between two people born at the same birth."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_009> <http://purl.org/ga4gh/kin.owl#KIN_008>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_009>)
TransitiveObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_009>)

# Object Property: KIN_010 (isMonozygoticMultipleBirthSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_010> "isMonozygoticMultipleBirthSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_010> "A relation between two people born at the same birth from a single fertilised ovum that splits."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_010> <http://purl.org/ga4gh/kin.owl#KIN_009>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_010>)
TransitiveObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_010>)

# Object Property: KIN_011 (isPolyzygoticMultipleBirthSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_011> "isPolyzygoticMultipleBirthSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_011> "A relation between two people born at the same birth from fertilisation of more than two ovums discharged in a single ovarian cycle."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_011> <http://purl.org/ga4gh/kin.owl#KIN_009>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_011>)
TransitiveObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_011>)

# Object Property: KIN_012 (isHalfSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_012> "isHalfSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_012> "A relation between two people that have a single biological parent (sperm or egg) in common."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_012> <http://purl.org/ga4gh/kin.owl#KIN_007>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_012>)

# Object Property: KIN_054 (isMaternalHalfSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_054> "isMaternalHalfSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_054> "A relation between two people that share the same biological mother (egg)"@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_054> <http://purl.org/ga4gh/kin.owl#KIN_012>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_054>)

# Object Property: KIN_055 (isPaternalHalfSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_055> "isPaternalHalfSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_055> "A relation between two people that share the same biological father (sperm)"@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_055> <http://purl.org/ga4gh/kin.owl#KIN_012>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_055>)

# Object Property: KIN_201 (isBiologicalParentalSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_201> "isBiologicalParentalSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_201> "A relation that indicates that a person is the biological sibling of a biological parent (egg or sperm) of another person (e.g. Biological Aunt or Uncle)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_201> <http://purl.org/ga4gh/kin.owl#KIN_002>)
InverseObjectProperties(<http://purl.org/ga4gh/kin.owl#KIN_201> <http://purl.org/ga4gh/kin.owl#KIN_201>)

# Object Property: KIN_202 (isBiologicalMaternalParentalSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_202> "isBiologicalMaternalParentalSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_202> "A relation that indicates that a person is the biological sibling of a biological mother (egg) of another person (e.g. Biological Maternal Aunt or Uncle)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_202> <http://purl.org/ga4gh/kin.owl#KIN_201>)

# Object Property: KIN_203 (isBiologicalPaternalParentalSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_203> "isBiologicalPaternalParentalSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_203> "A relation that indicates that a person is the biological sibling of a biological father (sperm) of another person (e.g. Biological Paternal Aunt or Uncle)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_203> <http://purl.org/ga4gh/kin.owl#KIN_201>)

# Object Property: KIN_204 (isBiologicalCousinOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_204> "isBiologicalCousinOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_204> "A relation between a person and a child of that person's biological parent's (egg or sperm) sibling."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_204> <http://purl.org/ga4gh/kin.owl#KIN_002>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_204>)

# Object Property: KIN_205 (isBiologicalMaternalCousinOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_205> "isBiologicalMaternalCousinOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_205> "A relation between a person and a child of that person's biological mother's (egg) sibling."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_205> <http://purl.org/ga4gh/kin.owl#KIN_204>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_205>)

# Object Property: KIN_206 (isBiologicalPaternalCousinOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_206> "isBiologicalPaternalCousinOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_206> "A relation between a person and a child of that person's biological father's (sperm) sibling."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_206> <http://purl.org/ga4gh/kin.owl#KIN_204>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_206>)

# Object Property: KIN_207 (isBiologicalGrandparentOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_207> "isBiologicalGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_207> "A relation between a person and a biological child of that person's biological child (egg or sperm)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_207> <http://purl.org/ga4gh/kin.owl#KIN_002>)
InverseObjectProperties(<http://purl.org/ga4gh/kin.owl#KIN_207> <http://purl.org/ga4gh/kin.owl#KIN_036>)

# Object Property: KIN_208 (isBiologicalMaternalGrandparentOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_208> "isBiologicalMaternalGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_208> "A relation between a person and a biological child of that person's biological daughter (egg)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_208> <http://purl.org/ga4gh/kin.owl#KIN_207>)

# Object Property: KIN_209 (isBiologicalPaternalGrandparentOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_209> "isBiologicalPaternalGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_209> "A relation between a person and a biological child of that person's biological son (sperm)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_209> <http://purl.org/ga4gh/kin.owl#KIN_207>)

# Object Property: KIN_036 (isBiologicalGrandchildOf)  [relabeled from isGrandchildOf]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_036> "isBiologicalGrandchildOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_036> "isGrandchildOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_036> "A relation between a person and a biological parent of that person's biological parent."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_036> <http://purl.org/ga4gh/kin.owl#KIN_002>)

# Object Property: KIN_210 (isBiologicalGreatGrandparentOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_210> "isBiologicalGreatGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_210> "A relation between a person and a biological parent (egg or sperm) of that person's biological grandparent."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_210> <http://purl.org/ga4gh/kin.owl#KIN_002>)
InverseObjectProperties(<http://purl.org/ga4gh/kin.owl#KIN_210> <http://purl.org/ga4gh/kin.owl#KIN_047>)

# Object Property: KIN_211 (isBiologicalMaternalGreatGrandparentOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_211> "isBiologicalMaternalGreatGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_211> "A relation between a person and a biological mother (egg) of that person's biological grandparent."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_211> <http://purl.org/ga4gh/kin.owl#KIN_210>)

# Object Property: KIN_212 (isBiologicalPaternalGreatGrandparentOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_212> "isBiologicalPaternalGreatGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_212> "A relation between a person and a biological father (sperm) of that person's biological grandparent."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_212> <http://purl.org/ga4gh/kin.owl#KIN_210>)

# Object Property: KIN_047 (isBiologicalGreatGrandchildOf)  [relabeled from isGreatGrandchildOf]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_047> "isBiologicalGreatGrandchildOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_047> "isGreatGrandchildOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_047> "A relation between a person and a biological parent of that person's biological grandparent."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_047> <http://purl.org/ga4gh/kin.owl#KIN_002>)

# Object Property: KIN_019 (isSocialLegalRelativeOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_019> "isSocialLegalRelativeOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_019> "A social or legal relationship between two people, for example, an adoptive parent."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_019> <http://purl.org/ga4gh/kin.owl#KIN_001>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_019>)

# Object Property: KIN_020 (isParentFigureOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_020> "isParentFigureOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_020> "A relation between a person who is regarded as having all or some of the characteristics of a parent and the child."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_020> <http://purl.org/ga4gh/kin.owl#KIN_019>)

# Object Property: KIN_021 (isFosterParentOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_021> "isFosterParentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_021> "A relation between a person and a child that temporarily enters into his or her family for a period of time, without becoming the child's legal parent."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_021> <http://purl.org/ga4gh/kin.owl#KIN_020>)

# Object Property: KIN_022 (isAdoptiveParentOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_022> "isAdoptiveParentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_022> "A legal relation between a person and a child that is adopted by that person. The adopted child is given the rights, privileges, and duties of a biological child by the adoptive person."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_022> <http://purl.org/ga4gh/kin.owl#KIN_020>)

# Object Property: KIN_023 (isStepParentOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_023> "isStepParentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_023> "A relation between a person and a child, where the person is married to the father or mother of a child but who is not that child's own father or mother."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_023> <http://purl.org/ga4gh/kin.owl#KIN_020>)

# Object Property: KIN_024 (isSiblingFigureOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_024> "isSiblingFigureOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_024> "A relation between two people that has all or some of the characteristics of a sibling relationship."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_024> <http://purl.org/ga4gh/kin.owl#KIN_019>)

# Object Property: KIN_025 (isStepSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_025> "isStepSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_025> "A relation between children born of two different families who have been joined by marriage, defacto or otherwise, of at least one of their respective parents."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_025> <http://purl.org/ga4gh/kin.owl#KIN_024>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_025>)

# Object Property: KIN_056 (isMaternalStepSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_056> "isMaternalStepSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_056> "A relation between children born of two different families who have been joined by marriage, defacto or otherwise. One is a biological child and the other is a step child of the same woman."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_056> <http://purl.org/ga4gh/kin.owl#KIN_025>)

# Object Property: KIN_057 (isPaternalStepSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_057> "isPaternalStepSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_057> "A relation between children born of two different families who have been joined by marriage, defacto or otherwise. One is a biological child and the other is a step child of the same man."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_057> <http://purl.org/ga4gh/kin.owl#KIN_025>)

# Object Property: KIN_026 (isPartnerOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_026> "isPartnerOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_026> "A socio-legal relationship between two people who live together and share a common domestic life."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_026> <http://purl.org/ga4gh/kin.owl#KIN_019>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_026>)

# Object Property: KIN_050 (isSeparatedPartnerOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_050> "isSeparatedPartnerOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_050> "A socio-legal relationship between two people who used to live together and share a common domestic life, but have now separated."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_050> <http://purl.org/ga4gh/kin.owl#KIN_019>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_050>)

# Object Property: KIN_013 (isSocialLegalParentalSiblingOf)  [renamed from isParentalSiblingOf; moved to social hierarchy]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_013> "isSocialLegalParentalSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_013> "isParentalSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_013> "A relation that indicates that a person is the socio-legal sibling of a socio-legal parent of another person (e.g. Socio-Legal Aunt or Uncle)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_013> <http://purl.org/ga4gh/kin.owl#KIN_019>)

# Object Property: KIN_213 (isSocialLegalMaternalParentalSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_213> "isSocialLegalMaternalParentalSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_213> "A relation that indicates that a person is the socio-legal sibling of a socio-legal mother of another person (e.g. Socio-Legal Maternal Aunt or Uncle)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_213> <http://purl.org/ga4gh/kin.owl#KIN_013>)

# Object Property: KIN_214 (isSocialLegalPaternalParentalSiblingOf)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_214> "isSocialLegalPaternalParentalSiblingOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_214> "A relation that indicates that a person is the socio-legal sibling of a socio-legal father of another person (e.g. Socio-Legal Paternal Aunt or Uncle)."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_214> <http://purl.org/ga4gh/kin.owl#KIN_013>)

# Object Property: KIN_014 (isSocialLegalCousinOf)  [renamed from isCousinOf; moved to social hierarchy]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_014> "isSocialLegalCousinOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_014> "isCousinOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_014> "A relation between a person and a child of that person's uncle or aunt."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_014> <http://purl.org/ga4gh/kin.owl#KIN_019>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_014>)

# Object Property: KIN_015 (isSocialLegalMaternalCousinOf)  [renamed from isMaternalCousinOf]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_015> "isSocialLegalMaternalCousinOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_015> "isMaternalCousinOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_015> "A relation between a person and a child of that person's mother's sibling."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_015> <http://purl.org/ga4gh/kin.owl#KIN_014>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_015>)

# Object Property: KIN_016 (isSocialLegalPaternalCousinOf)  [renamed from isPaternalCousinOf]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_016> "isSocialLegalPaternalCousinOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_016> "isPaternalCousinOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_016> "A relation between a person and a child of that person's father's sibling."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_016> <http://purl.org/ga4gh/kin.owl#KIN_014>)
SymmetricObjectProperty(<http://purl.org/ga4gh/kin.owl#KIN_016>)

# Object Property: KIN_017 (isSocialLegalGrandparentOf)  [renamed from isGrandparentOf; moved to social hierarchy]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_017> "isSocialLegalGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_017> "isGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_017> "A relation between a person and a child of that person's child."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_017> <http://purl.org/ga4gh/kin.owl#KIN_019>)

# Object Property: KIN_052 (isSocialLegalMaternalGrandparentOf)  [renamed from isMaternalGrandparentOf]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_052> "isSocialLegalMaternalGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_052> "isMaternalGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_052> "A relation between a person and a child of that person's daughter."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_052> <http://purl.org/ga4gh/kin.owl#KIN_017>)

# Object Property: KIN_053 (isSocialLegalPaternalGrandparentOf)  [renamed from isPaternalGrandparentOf]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_053> "isSocialLegalPaternalGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_053> "isPaternalGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_053> "A relation between a person and a child of that person's son."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_053> <http://purl.org/ga4gh/kin.owl#KIN_017>)

# Object Property: KIN_018 (isSocialLegalGreatGrandparentOf)  [renamed from isGreatGrandparentOf; moved to social hierarchy]

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_018> "isSocialLegalGreatGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.org/ga4gh/kin.owl#KIN_018> "isGreatGrandparentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_018> "A relation between a person and a child of that person's grandchild."@en)
SubObjectPropertyOf(<http://purl.org/ga4gh/kin.owl#KIN_018> <http://purl.org/ga4gh/kin.owl#KIN_019>)


############################
#   Deprecated Properties
############################

# KIN_003 (isBiologicalParentOf) — deprecated; replaced by KIN_200

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_003> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_003> "isBiologicalParentOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_003> "DEPRECATED. Use KIN_200 (isBiologicalParentOf). A relation that indicates that a person is the biological parent of another person."@en)

# KIN_030 (isConsanguineousPartnerOf) — deprecated; consanguinity moved to Relationship.consanguinity field

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_030> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_030> "isConsanguineousPartnerOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_030> "DEPRECATED. Consanguinity is now represented by the consanguinity field on the Pedigree Relationship concept. A socio-legal relationship between two people who live together, share a common domestic life and are closely related biologically (second cousins or closer)."@en)

# KIN_031 (hasSex) — deprecated; sex removed from KIN ontology

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_031> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_031> "hasSex"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_031> "DEPRECATED. Sex is now represented on the Individual concept in the Pedigree Standard. A relation used to indicate the sex of a person."@en)

# KIN_039 (hasGestationalCarrier) — deprecated; replaced by inverse KIN_005 (isGestationalCarrierOf)

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_039> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_039> "hasGestationalCarrier"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_039> "DEPRECATED. Use the inverse KIN_005 (isGestationalCarrierOf). A relation between the child and a person who carried a fertilised egg in their womb and gave birth to a child on behalf of another."@en)

# KIN_046 (hasParentalSibling) — deprecated; replaced by inverse KIN_201 (isBiologicalParentalSiblingOf)

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_046> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_046> "hasParentalSibling"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_046> "DEPRECATED. Use the inverse of KIN_201 (isBiologicalParentalSiblingOf) or KIN_013 (isSocialLegalParentalSiblingOf). A relation that indicates that a person has a parental sibling relationship with another person."@en)

# KIN_051 (isSeparatedConsanguineousPartnerOf) — deprecated; consanguinity moved to Relationship.consanguinity

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_051> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_051> "isSeparatedConsanguineousPartnerOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_051> "DEPRECATED. Consanguinity is now represented by the consanguinity field on the Pedigree Relationship concept. A socio-legal relationship between two separated people who were closely related biologically."@en)

# KIN_058 (isMaternalUncleOf) — deprecated; use KIN_202 (isBiologicalMaternalParentalSiblingOf)

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_058> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_058> "isMaternalUncleOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_058> "DEPRECATED. Use KIN_202 (isBiologicalMaternalParentalSiblingOf). Gender of individuals removed from KIN ontology. A relation between a man and the child of that man's sister."@en)

# KIN_059 (isPaternalUncleOf) — deprecated; use KIN_203 (isBiologicalPaternalParentalSiblingOf)

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_059> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_059> "isPaternalUncleOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_059> "DEPRECATED. Use KIN_203 (isBiologicalPaternalParentalSiblingOf). Gender of individuals removed from KIN ontology. A relation between a man and the child of that man's brother."@en)

# KIN_060 (isMaternalAuntOf) — deprecated; use KIN_202 (isBiologicalMaternalParentalSiblingOf)

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_060> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_060> "isMaternalAuntOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_060> "DEPRECATED. Use KIN_202 (isBiologicalMaternalParentalSiblingOf). Gender of individuals removed from KIN ontology. A relation between a woman and the child of that woman's sister."@en)

# KIN_061 (isPaternalAuntOf) — deprecated; use KIN_203 (isBiologicalPaternalParentalSiblingOf)

AnnotationAssertion(owl:deprecated <http://purl.org/ga4gh/kin.owl#KIN_061> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_061> "isPaternalAuntOf"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_061> "DEPRECATED. Use KIN_203 (isBiologicalPaternalParentalSiblingOf). Gender of individuals removed from KIN ontology. A relation between a woman and the child of that woman's brother."@en)


############################
#   Classes
############################

# Class: KIN_991 (OtherSex)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_991> "OtherSex"^^rdfs:Literal)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_991> "It is not possible to accurately assess the applicability of male or female."@en)
SubClassOf(<http://purl.org/ga4gh/kin.owl#KIN_991> <http://purl.org/ga4gh/kin.owl#KIN_997>)

# Class: KIN_992 (UnknownSex)

