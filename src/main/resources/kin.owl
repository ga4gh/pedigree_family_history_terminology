AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_992> "Not assessed or not available."@en)
SubClassOf(<http://purl.org/ga4gh/kin.owl#KIN_992> <http://purl.org/ga4gh/kin.owl#KIN_997>)

# Class: KIN_993 (Woman)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_993> "Woman")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_993> "A person assigned female at birth."@en)
SubClassOf(<http://purl.org/ga4gh/kin.owl#KIN_993> <http://purl.org/ga4gh/kin.owl#KIN_998>)

# Class: KIN_994 (Man)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_994> "Man")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_994> "A person assigned male at birth."@en)
SubClassOf(<http://purl.org/ga4gh/kin.owl#KIN_994> <http://purl.org/ga4gh/kin.owl#KIN_998>)

# Class: KIN_995 (Female)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_995> "Female")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_995> "Female sex."@en)
SubClassOf(<http://purl.org/ga4gh/kin.owl#KIN_995> <http://purl.org/ga4gh/kin.owl#KIN_997>)
DisjointClasses(<http://purl.org/ga4gh/kin.owl#KIN_995> <http://purl.org/ga4gh/kin.owl#KIN_996>)

# Class: KIN_996 (Male)

AnnotationAssertion(rdfs:label <http://purl.org/ga4gh/kin.owl#KIN_996> "Male")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.org/ga4gh/kin.owl#KIN_996> "Male sex."@en)
SubClassOf(<http://purl.org/ga4gh/kin.owl#KIN_996> <http://purl.org/ga4gh/kin.owl#KIN_997>)

# Class: KIN_997 (Sex)

