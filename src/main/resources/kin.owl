############################
#   Property Chains
############################

# Biological grandparent inferred from two biological parent hops
SubObjectPropertyOf(ObjectPropertyChain(<http://purl.org/ga4gh/kin.owl#KIN_200> <http://purl.org/ga4gh/kin.owl#KIN_200>) <http://purl.org/ga4gh/kin.owl#KIN_207>)

# Biological maternal/paternal grandparent from specific parent + biological parent
SubObjectPropertyOf(ObjectPropertyChain(<http://purl.org/ga4gh/kin.owl#KIN_200> <http://purl.org/ga4gh/kin.owl#KIN_027>) <http://purl.org/ga4gh/kin.owl#KIN_208>)
SubObjectPropertyOf(ObjectPropertyChain(<http://purl.org/ga4gh/kin.owl#KIN_200> <http://purl.org/ga4gh/kin.owl#KIN_028>) <http://purl.org/ga4gh/kin.owl#KIN_209>)

# Biological great-grandparent from grandparent + biological parent
SubObjectPropertyOf(ObjectPropertyChain(<http://purl.org/ga4gh/kin.owl#KIN_207> <http://purl.org/ga4gh/kin.owl#KIN_200>) <http://purl.org/ga4gh/kin.owl#KIN_210>)

# Biological cousin from biological child + biological sibling + biological parent
SubObjectPropertyOf(ObjectPropertyChain(<http://purl.org/ga4gh/kin.owl#KIN_032> <http://purl.org/ga4gh/kin.owl#KIN_007> <http://purl.org/ga4gh/kin.owl#KIN_200>) <http://purl.org/ga4gh/kin.owl#KIN_204>)
SubObjectPropertyOf(ObjectPropertyChain(ObjectInverseOf(<http://purl.org/ga4gh/kin.owl#KIN_027>) <http://purl.org/ga4gh/kin.owl#KIN_007> <http://purl.org/ga4gh/kin.owl#KIN_200>) <http://purl.org/ga4gh/kin.owl#KIN_205>)
SubObjectPropertyOf(ObjectPropertyChain(ObjectInverseOf(<http://purl.org/ga4gh/kin.owl#KIN_028>) <http://purl.org/ga4gh/kin.owl#KIN_007> <http://purl.org/ga4gh/kin.owl#KIN_200>) <http://purl.org/ga4gh/kin.owl#KIN_206>)

)
